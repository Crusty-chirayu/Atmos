# ATMOS Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file with real credentials.
# SECURITY.md §2: server-only secrets must never appear in client bundles.

# ── Application ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ── Supabase ──────────────────────────────────────────────────────────────
# Find these in your Supabase project dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose in the browser or logs
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google Gemini ─────────────────────────────────────────────────────────
# Server-only — called exclusively from trusted server-side code (AI.md §2)
GEMINI_API_KEY=your-gemini-api-key

# ── Weather Provider ──────────────────────────────────────────────────────
# Open-Meteo is free and open; no key required for standard use.
# Set only if you need to override the base URL (e.g., for a caching proxy).
# OPEN_METEO_BASE_URL=https://api.open-meteo.com

# ── Maps ──────────────────────────────────────────────────────────────────
# Mapbox public token — restrict scopes to your domain in Mapbox dashboard.
# Required only when Mapbox map features are implemented (M5).
# MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token

# ── Web Push (M7) ─────────────────────────────────────────────────────────
# Generate VAPID keys with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:admin@atmos.app

# ── Observability (optional) ──────────────────────────────────────────────
# Add your monitoring provider config here after selection (M8).
# NEXT_PUBLIC_SENTRY_DSN=
