# ATMOS Environment Variables Reference (.env.example)
# Copy this file to .env.local for local development.
# Never commit .env.local or expose production secrets.
# SECURITY REQUIREMENT: Server-only variables must NEVER be exposed in client bundles or client logs.

# ── Application Runtime ───────────────────────────────────────────────────
# Base application URL (used for metadataBase, absolute redirects, auth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment mode: development | preview | production
NEXT_PUBLIC_APP_ENV=development

# ── Supabase Integration ───────────────────────────────────────────────────
# Public project URL (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key (Safe in browser, governed by PostgreSQL RLS policies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# SERVER-ONLY — Service role key with administrative bypass (used for account deletion / cron)
# NEVER EXPOSE IN CLIENT CODE OR SOURCE MAPS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── OpenRouter AI Platform ───────────────────────────────────────────────
# Server-only — used in /api/ai/chat and server-side grounding services
# Get an API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Optional model override (defaults to meta-llama/llama-3.3-70b-instruct or google/gemini-2.5-flash)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Legacy Google Gemini fallback (optional)
# GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ── Weather Providers (M1-M5) ─────────────────────────────────────────────
# Open-Meteo is free and open; no API key required for non-commercial use.
# Override only when utilizing a dedicated enterprise endpoint or caching proxy.
# OPEN_METEO_BASE_URL=https://api.open-meteo.com

# ── Web Push Notifications (M7-M8) ────────────────────────────────────────
# Generate VAPID keypair using: npx web-push generate-vapid-keys
# Public key shared with browser PushManager:
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BKyourVapidPublicKeyHere

# Server-only VAPID private key (NEVER expose to browser):
VAPID_PRIVATE_KEY=yourVapidPrivateKeyHere

# Contact mailto: or URI required by the Web Push protocol (RFC 8292):
VAPID_SUBJECT=mailto:security@atmos.app

# ── Scheduled Tasks & Cron Security (M7) ──────────────────────────────────
# Secret token required to authenticate invocations to /api/cron/evaluate-alerts
# Minimum 32 random characters recommended:
CRON_SECRET=your-random-32-char-cron-secret-token

# ── Map Overlays (Optional) ───────────────────────────────────────────────
# Mapbox public access token (optional; ATMOS uses open tile layers by default)
# MAPBOX_ACCESS_TOKEN=pk.your-mapbox-access-token
